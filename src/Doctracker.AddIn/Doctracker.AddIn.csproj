    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)Doctracker.OcrWorker.x86.exe">
        <Link>Doctracker.OcrWorker.x86.exe</Link>
        <TargetPath>Doctracker.OcrWorker.x86.exe</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <PublishState>Include</PublishState>
      </Content>
      <Content Include="$(IntermediateOutputPath)Doctracker.OcrWorker.x64.exe">
        <Link>Doctracker.OcrWorker.x64.exe</Link>
        <TargetPath>Doctracker.OcrWorker.x64.exe</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <PublishState>Include</PublishState>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="EnsureOcrAssets" BeforeTargets="AssignTargetPaths">
    <Exec
      Command="&quot;$(ProjectDir)..\..\scripts\prepare-assets.cmd&quot;"
      Condition="!Exists('$(ProjectDir)tessdata\fra.traineddata') or !Exists('$(ProjectDir)tessdata\eng.traineddata')" />
    <Error
      Condition="!Exists('$(ProjectDir)tessdata\fra.traineddata') or !Exists('$(ProjectDir)tessdata\eng.traineddata')"
      Text="Les modèles OCR français et anglais n'ont pas pu être préparés." />
    <ItemGroup>
      <Content Include="$(ProjectDir)tessdata\fra.traineddata">
