        <TargetPath>tessdata\eng.traineddata</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <PublishState>Include</PublishState>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="IncludeTesseractNativeAssetsInManifest" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content
        Include="@(None)"
        Condition="'%(None.Extension)' == '.dll' and ('%(None.Filename)' == 'tesseract50' or '%(None.Filename)' == 'leptonica-1.82.0')">
        <Link>%(None.Link)</Link>
        <TargetPath>%(None.Link)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <PublishState>Include</PublishState>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="IncludePdfiumNativeAssetsInManifest" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_PdfiumNativeContent
        Include="@(Content)"
        Condition="'%(Content.Filename)' == 'pdfium' and '%(Content.Extension)' == '.dll'" />
      <_PdfiumNativeNone
        Include="@(None)"
        Condition="'%(None.Filename)' == 'pdfium' and '%(None.Extension)' == '.dll'" />
      <Content Remove="@(_PdfiumNativeContent)" />
      <None Remove="@(_PdfiumNativeNone)" />
      <Content Include="@(_PdfiumNativeContent);@(_PdfiumNativeNone)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <PublishState>Include</PublishState>
      </Content>
    </ItemGroup>
    <Error
      Condition="'@(_PdfiumNativeContent)' == '' and '@(_PdfiumNativeNone)' == ''"
      Text="Les bibliothèques natives PDFium n'ont pas été fournies par les packages NuGet." />
  </Target>
  <Target Name="VerifyPdfiumNativeOutput" AfterTargets="Build">
    <Error
      Condition="!Exists('$(TargetDir)x86\pdfium.dll')"
      Text="La bibliothèque PDFium x86 est absente de $(TargetDir)x86." />
    <Error
      Condition="!Exists('$(TargetDir)x64\pdfium.dll')"
      Text="La bibliothèque PDFium x64 est absente de $(TargetDir)x64." />
  </Target>
  <Target Name="EnsureManifestSigningCertificate"
          BeforeTargets="VisualStudioForApplicationsBuild"
          Condition="'$(ManifestCertificateThumbprint)' == '' and '$(DesignTimeBuild)' != 'true'">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$certificate = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -eq 'CN=Doctracker Development' -and $_.HasPrivateKey -and $_.NotAfter -gt (Get-Date).AddDays(1) } | Sort-Object NotAfter -Descending | Select-Object -First 1; if ($null -eq $certificate) { $certificate = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=Doctracker Development' -CertStoreLocation 'Cert:\CurrentUser\My' -KeyAlgorithm RSA -KeyLength 2048 -HashAlgorithm SHA256 -KeyExportPolicy NonExportable -NotAfter (Get-Date).AddDays(30) }; Write-Output $certificate.Thumbprint&quot;"
      ConsoleToMSBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GeneratedCertificateThumbprint" />
    </Exec>
    <PropertyGroup>
      <ManifestCertificateThumbprint>@(_GeneratedCertificateThumbprint)</ManifestCertificateThumbprint>
      <CertificateThumbprint>@(_GeneratedCertificateThumbprint)</CertificateThumbprint>
    </PropertyGroup>
    <Error Condition="'$(CertificateThumbprint)' == ''"
           Text="Impossible de créer ou de retrouver le certificat temporaire de signature Doctracker." />
  </Target>
